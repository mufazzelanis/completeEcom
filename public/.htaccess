<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Canonicalize to the non-www host — without this, www.mitavin.com and mitavin.com
    # both served the same pages with no redirect between them, so Google (and every
    # inbound link using either form) saw two separate copies of the entire site, which
    # is exactly the kind of duplicate-content signal that confuses indexing/HTTPS
    # evaluation. %1 is whatever follows "www." (the bare host), captured by the group
    # in the condition below.
    #
    # Path taken from the rule's own match ($1, relative to this public/ folder) rather
    # than %{REQUEST_URI}: on the live host the site root rewrites every request into
    # public/, and LiteSpeed then reports REQUEST_URI *with* that internal /public prefix —
    # so www.mitavin.com/x was being redirected to mitavin.com/public/x.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

    # Never serve the site under /public/… — when that folder name leaks into a URL,
    # Laravel treats /public as the site's base path and builds every link and canonical
    # tag with it: a complete second copy of the site for Google to find (Search Console:
    # "Duplicate, Google chose different canonical"). THE_REQUEST is the browser's original
    # request line, untouched by internal rewrites, so this only matches a URL that really
    # contains /public. The query string carries over to the redirect automatically.
    RewriteCond %{THE_REQUEST} \s/public/?[\s?] [NC]
    RewriteRule ^ / [L,R=301]
    RewriteCond %{THE_REQUEST} \s/public(/[^\s?]*[^\s?/])/?[\s?] [NC]
    RewriteRule ^ %1 [L,R=301]

    # Same for the front controller's own name: /index.php served the homepage (and
    # /index.php/shop the shop, etc.) as a 200 duplicate whose canonical pointed at
    # /public/index.php. A real request naming index.php goes to the clean URL; the
    # internal rewrite to index.php below never matches, since THE_REQUEST is untouched.
    RewriteCond %{THE_REQUEST} \s/(?:public/)?index\.php/([^\s?]*)[\s?] [NC]
    RewriteRule ^ /%1 [L,R=301,NE]
    RewriteCond %{THE_REQUEST} \s/(?:public/)?index\.php[\s?] [NC]
    RewriteRule ^ / [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder... (path from the match, not REQUEST_URI —
    # same /public prefix leak as the www rule above: /shop/ was going to /public/shop)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Compress text-based responses (HTML/CSS/JS/JSON/SVG) — was disabled entirely, so every
# page was being sent uncompressed. LiteSpeed honors standard mod_deflate directives.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf application/font-woff application/vnd.ms-fontobject
</IfModule>

# Hotlink protection — stops other sites from directly embedding our uploaded images
# (<img src="oursite.com/storage/...">) in their own pages, which is both a bandwidth
# drain and an easy way for someone else to reuse our content without ever visiting the
# site. Only fires when a Referer is actually present and points elsewhere — direct
# access (typed URL, bookmarks) and link-preview crawlers (Facebook/WhatsApp/Google,
# which send no Referer at all) are unaffected, so social share previews still work.
#
# Both a %{HTTP_HOST}-in-later-pattern version AND a %1 cross-condition-backreference
# version of a self-referencing host check were tried here and both silently failed on
# the live LiteSpeed host (confirmed live: every non-empty Referer got blocked
# regardless of its actual domain, meaning the placeholder was never being substituted
# at all — this rewrite engine doesn't support either mechanism reliably). Reverted to
# plain hardcoded domain matching, which IS confirmed working on this host.
#
# So the domain doesn't have to be hand-edited here again on the next domain/subdomain
# change (this whole rule went down site-wide once already because mitavin.com wasn't
# added when the site moved off mitavin.a-haque.com), the allowed-domain line below is
# auto-generated from APP_URL by `php artisan htaccess:sync-domain`, which runs
# automatically on every `composer install`/`composer update` (see composer.json's
# post-autoload-dump). Keeping APP_URL correct in .env — already required for the app
# to work correctly in general — is now the only thing that ever needs to happen on a
# domain change; this file updates itself on the next deploy.
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?completeecom\.test [NC]
    # BEGIN hotlink-allowed-domain (auto-generated by `php artisan htaccess:sync-domain` — do not edit by hand, change APP_URL in .env instead)
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?mitavin\.com [NC]
    # END hotlink-allowed-domain
    RewriteRule \.(jpe?g|png|gif|webp|svg)$ - [F,NC,L]
</IfModule>

# Long-lived caching for static assets. Vite-built CSS/JS are content-hashed (a code change
# gets a new filename), so caching them for a year is safe; images/fonts get a shorter,
# still-generous window since those get replaced in place by the admin panel.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    # LiteSpeed serves .js as text/javascript (the current standard MIME type), so the line
    # above alone never matched — every built JS bundle went out with no cache lifetime.
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
